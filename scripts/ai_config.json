{
  "ai_providers": {
    "openai": {
      "name": "OpenAI",
      "api_key_env": "OPENAI_API_KEY",
      "base_url": "https://api.openai.com/v1",
      "models": ["gpt-3.5-turbo", "gpt-4", "gpt-4-turbo-preview"],
      "default_model": "gpt-3.5-turbo"
    },
    "siliconflow": {
      "name": "硅基流动API",
      "api_key_env": "OPENAI_API_KEY",
      "base_url": "https://api.siliconflow.cn/v1",
      "models": [
        "deepseek-ai/DeepSeek-V3",
        "deepseek-ai/DeepSeek-V3.1", 
        "deepseek-ai/DeepSeek-R1",
        "Qwen/QwQ-32B",
        "Qwen/QwQ-7B", 
        "Qwen/QwQ-14B"
      ],
      "default_model": "deepseek-ai/DeepSeek-V3",
      "extra_params": {
        "thinking_budget": 4096,
        "top_p": 0.7,
        "temperature": 0.1
      }
    },
    "deepseek": {
      "name": "DeepSeek AI",
      "api_key_env": "OPENAI_API_KEY",
      "base_url": "https://api.siliconflow.cn/v1",
      "models": [
        "deepseek-ai/DeepSeek-V3",
        "deepseek-ai/DeepSeek-V3.1", 
        "deepseek-ai/DeepSeek-R1",
        "deepseek-ai/DeepSeek-V2.5"
      ],
      "default_model": "deepseek-ai/DeepSeek-V3",
      "extra_params": {
        "temperature": 0.1,
        "top_p": 0.9
      }
    },
    "anthropic": {
      "name": "Anthropic Claude",
      "api_key_env": "ANTHROPIC_API_KEY",
      "base_url": "https://api.anthropic.com",
      "models": ["claude-3-sonnet-20240229", "claude-3-haiku-20240307"],
      "default_model": "claude-3-sonnet-20240229"
    }
  },
  "smart_features": {
    "code_analysis": true,
    "duplicate_prevention": true,
    "requirement_parsing": true,
    "code_generation": true,
    "backup_before_modify": true
  },
  "file_patterns": {
    "models": ["**/models.py"],
    "views": ["**/views.py"],
    "serializers": ["**/serializers.py"],
    "urls": ["**/urls.py"],
    "components": ["**/*.vue"],
    "services": ["**/*Service.js"],
    "tests": ["**/test_*.py", "**/*.spec.js"]
  },
  "merge_strategies": {
    "models": "append_fields",
    "views": "append_methods",
    "serializers": "append_fields",
    "components": "merge_template",
    "services": "append_methods"
  },
  "backup_settings": {
    "enabled": true,
    "backup_dir": "backups",
    "max_backups": 5
  },
  "validation": {
    "syntax_check": true,
    "import_check": true,
    "basic_functionality": true
  },
  "prompts": {
    "requirement_parsing": "请分析以下需求文档，提取关键信息：\n\n{content}\n\n请以JSON格式返回以下信息：\n- 功能标题\n- 详细功能描述\n- 技术规格\n- 验收标准\n- 依赖关系",
    "code_generation": "基于以下需求生成代码：\n\n{requirement}\n\n现有代码结构：\n{existing_code}\n\n请生成符合项目规范的代码，包括必要的导入、注释和错误处理。",
    "code_review": "请审查以下代码，检查：\n- 代码质量\n- 安全性\n- 性能\n- 最佳实践\n\n{code}"
  }
}