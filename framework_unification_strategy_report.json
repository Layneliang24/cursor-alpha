    "fixture_usage": "import pytest\n\n@pytest.fixture\ndef sample_data():\n    \"\"\"测试数据fixture\"\"\"\n    return {\"key\": \"value\", \"number\": 42}\n\nclass TestWithFixtures:\n    \"\"\"使用fixture的测试类\"\"\"\n    \n    def test_with_fixture(self, sample_data):\n        \"\"\"使用fixture的测试\"\"\"\n        assert sample_data[\"key\"] == \"value\"\n        assert sample_data[\"number\"] == 42\n"
