{
  "name": "alpha-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:debug": "vitest --inspect-brk",
    "test:report": "vitest run --reporter=html --outDir=coverage/report",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:validate": "npm run test:coverage && npm run test:e2e",
    "playwright:install": "playwright install",
    "playwright:test": "playwright test",
    "playwright:test:ui": "playwright test --ui",
    "playwright:test:headed": "playwright test --headed",
    "playwright:test:debug": "playwright test --debug",
    "playwright:report": "playwright show-report"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.2.5",
    "pinia": "^2.1.7",
    "element-plus": "^2.4.4",
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.6.2",
    "vue-i18n": "^9.8.0",
    "dayjs": "^1.11.10",
    "echarts": "^5.4.3",
    "vue-echarts": "^6.6.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.2",
    "vite": "^5.0.8",
    "vitest": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "@vitest/coverage-v8": "^1.0.4",
    "@vue/test-utils": "^2.4.3",
    "@pinia/testing": "^0.1.3",
    "jsdom": "^23.0.1",
    "msw": "^2.0.8",
    "@playwright/test": "^1.40.1",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.2",
    "@vue/eslint-config-prettier": "^9.0.0",
    "prettier": "^3.1.1"
  }
}
